  L5 -> L5 [label="p\nx0, x2 := 0"];
  L5 -> L5 [label="r\nx0, x2 := 0"];
  L5 -> L7 [label="\nx0, x2 := 0"];
  L6 -> L2 [label="x0 > 1 && x1 >= 2\nr\nx2 := 0"];
  L6 -> L2 [label="x0 > 1 && x1 >= 2\np,other\nx2 := 0"];
  L6 -> L3 [label="x1 >= 2\np\nx2 := 0"];
