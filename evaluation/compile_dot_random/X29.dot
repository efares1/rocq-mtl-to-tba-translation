digraph TBA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L3 [shape=doublecircle, label="L3"];
  L0 -> L1 [label="p\nx0, x1, x2 := 0"];
  L0 -> L1 [label="r\nx0, x1, x2 := 0"];
  L1 -> L2 [label="x0 > 1 && x1 >= 2\nany\nx2 := 0"];
  L1 -> L1 [label="p\nx0, x2 := 0"];
  L1 -> L1 [label="r\nx0, x2 := 0"];
  L1 -> L3 [label="x1 >= 2\np\nx2 := 0"];
  L1 -> L3 [label="x1 >= 2\nr\nx2 := 0"];
  L2 -> L2 [label="any\nx2 := 0"];
  L3 -> L2 [label="x0 > 1\nany\nx2 := 0"];
  L3 -> L3 [label="p\nx2 := 0"];
  L3 -> L3 [label="r\nx2 := 0"];
}
