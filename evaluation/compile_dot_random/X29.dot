  L1 -> L6 [label="r\nx0, x2 := 0"];
  L2 -> L2 [label="any\nx2 := 0"];
  L3 -> L2 [label="x0 > 1\nany\nx2 := 0"];
  L3 -> L3 [label="p\nx2 := 0"];
  L3 -> L3 [label="r\nx2 := 0"];
  L4 -> L2 [label="x0 > 1\nr\nx2 := 0"];
