digraph TBA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L0 -> L1 [label="p"];
  L0 -> L2 [label="other\nx0 := 0"];
  L1 -> L1 [label="any"];
  L2 -> L1 [label="x0 >= 3\nany"];
  L2 -> L2 [label="p,other"];
}
