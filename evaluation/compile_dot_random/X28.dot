digraph TBA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L1 [shape=circle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L3 [shape=circle, label="L3"];
  L4 [shape=doublecircle, label="L4"];
  L5 [shape=circle, label="L5"];
  L0 -> L1 [label="any\nx0 := 0"];
  L1 -> L1 [label="any"];
  L1 -> L2 [label="x0 >= 2\nq"];
  L1 -> L2 [label="x0 >= 2\nr"];
  L1 -> L3 [label="x0 >= 2\nother"];
  L1 -> L4 [label="q"];
  L1 -> L4 [label="r"];
  L2 -> L2 [label="any"];
  L3 -> L2 [label="q"];
  L3 -> L2 [label="r"];
  L3 -> L3 [label="other"];
  L4 -> L4 [label="q"];
  L4 -> L4 [label="r"];
  L4 -> L5 [label="other"];
  L5 -> L4 [label="q"];
  L5 -> L4 [label="r"];
  L5 -> L5 [label="other"];
}
