digraph TBA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=doublecircle, label="L0"];
  L1 [shape=doublecircle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L3 [shape=doublecircle, label="L3"];
  L4 [shape=doublecircle, label="L4"];
  L0 -> L1 [label="p\nx0, x1 := 0"];
  L0 -> L2 [label="\nx2 := 0"];
  L1 -> L1 [label="p\nx0 := 0"];
  L1 -> L3 [label="x0 >= 2 && x1 >= 3\nany"];
  L1 -> L4 [label="x1 >= 3\np"];
  L2 -> L2 [label="r"];
  L2 -> L3 [label="x2 > 3\nany"];
  L3 -> L3 [label="any"];
  L4 -> L3 [label="x0 >= 2\nany"];
  L4 -> L4 [label="p"];
}
