digraph TBA {
  rankdir=LR;
  node [shape=circle];
  init [shape=point];
  init -> L0;
  L0 [shape=circle, label="L0"];
  L1 [shape=circle, label="L1"];
  L2 [shape=doublecircle, label="L2"];
  L3 [shape=circle, label="L3"];
  L4 [shape=doublecircle, label="L4"];
  L5 [shape=circle, label="L5"];
  L0 -> L0 [label="any\nx2 := 0"];
  L0 -> L1 [label="any\nx0, x2 := 0"];
  L1 -> L1 [label="any\nx2 := 0"];
  L1 -> L2 [label="x0 >= 2\nq\nx2 := 0"];
  L1 -> L3 [label="x0 >= 2\np,other\nx2 := 0"];
  L1 -> L4 [label="q\nx2 := 0"];
  L2 -> L2 [label="any\nx2 := 0"];
  L3 -> L2 [label="q\nx2 := 0"];
  L3 -> L3 [label="p,other\nx2 := 0"];
  L4 -> L4 [label="q\nx2 := 0"];
  L4 -> L5 [label="p,other\nx2 := 0"];
  L5 -> L4 [label="q\nx2 := 0"];
  L5 -> L5 [label="p,other\nx2 := 0"];
}
